# Serverning ishlash rejimi: development yoki production
NODE_ENV=development
PORT=5000

# Frontend qaysi manzillardan so'rov yubora oladi (CORS).
# Bir nechtasini vergul bilan ajrating: http://localhost:5173,https://example.com
CLIENT_URL=http://localhost:5173

# JWT token imzolash uchun MAJBURIY. Uzun, tasodifiy qator bo'lsin.
# Masalan generatsiya qilish uchun: openssl rand -hex 32
JWT_SECRET=

# Birinchi marta ishga tushirilganda avtomatik yaratiladigan admin.
# Production'da BU IKKALASI ham majburiy — aks holda server ishga tushmaydi.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# ChatBot uchun Groq API (https://console.groq.com) — ixtiyoriy,
# bo'lmasa chatbot statik javob beradi.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Telegram bot orqali arizalar/xabarlar haqida bildirishnoma olish uchun (ixtiyoriy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
